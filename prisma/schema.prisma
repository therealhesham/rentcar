generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

/// إعدادات عامة للموقع (مفتاح فريد + قيمة نصية).
model SiteSetting {
  id        Int      @id @default(autoincrement())
  key       String   @unique @db.VarChar(64)
  value     String   @db.Text
  updatedAt DateTime @updatedAt
}

/// شروط وأحكام التأجير — يُدارها الأدمن من لوحة التحكم وتُعرض في صفحة الشروط ولحظة الحجز.
model RentalTerm {
  id        Int      @id @default(autoincrement())
  titleAr   String   @db.VarChar(255)
  titleEn   String?  @db.VarChar(255)
  bodyAr    String   @db.Text
  bodyEn    String?  @db.Text
  sortOrder Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isActive, sortOrder])
}

/// سجل النشاط — تسجيلات دخول العملاء والموظفين ومشاهدات الصفحات، يُعرض في /admin/logs.
model ActivityLog {
  id         Int      @id @default(autoincrement())
  /// CUSTOMER_LOGIN | ADMIN_LOGIN | PAGE_VIEW | CAR_VIEW | BOOKING_PAYMENT | BOOKING_REFUND
  kind       String   @db.VarChar(32)
  /// مسار الصفحة لمشاهدات الصفحات
  path       String?  @db.VarChar(512)
  /// وصف بواسطة — اسم/بريد الموظف أو جوال/بريد العميل
  actorLabel String?  @db.VarChar(255)
  userId     Int?
  /// موديل السيارة لمشاهدات السيارات (CAR_VIEW)
  carModelId Int?
  ip         String?  @db.VarChar(64)
  userAgent  String?  @db.VarChar(512)
  createdAt  DateTime @default(now())

  @@index([kind, createdAt])
  @@index([createdAt])
  @@index([kind, carModelId])
}

/// حساب عميل على الموقع العام فقط (تسجيل / دخول / حجز). موظفو الإدارة في `AdminEmployee`.
model User {
  id           Int      @id @default(autoincrement())
  email        String   @unique @db.VarChar(255)
  passwordHash String?  @db.VarChar(255)
  name         String?  @db.VarChar(255)
  /// موحّد مع الحجز: +9665XXXXXXXX
  phone        String?  @unique @db.VarChar(16)
  /// مواطن = CITIZEN، مقيم = RESIDENT، زائر = VISITOR
  idDocumentKind        String?   @db.VarChar(24)
  nationalIdNumber      String?   @db.VarChar(16)
  passportNumber        String?   @db.VarChar(32)
  licenseNumber         String?   @db.VarChar(64)
  /// تاريخ انتهاء رخصة القيادة المخزّن في حساب العميل.
  licenseExpiryDate     DateTime? @db.Date
  idCardImageUrl        String?   @db.Text
  driverLicenseImageUrl String?   @db.Text
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  bookingRequests BookingRequest[]
  subscriptions   UserSubscription[]
}

/// مدينة تتبعها فروع الاستلام (للتجميع في الحجز ولوحة الإدارة).
model City {
  id        Int      @id @default(autoincrement())
  slug      String   @unique @db.VarChar(64)
  name      String   @db.VarChar(255)
  nameEn    String?  @db.VarChar(255)
  sortOrder Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  branches Branch[]

  /// رسوم شحن من هذه المدينة إلى مدينة أخرى (حجز أسطول).
  interCityShippingFrom InterCityShippingFee[] @relation("InterCityShippingFrom")
  interCityShippingTo   InterCityShippingFee[] @relation("InterCityShippingTo")

  @@index([sortOrder])
  @@index([isActive])
}

/// رسوم شحن لمرة واحدة عند اختلاف مدينة الاستلام/التوصيل عن مدينة إرجاع المركبة (غير شامل الضريبة).
model InterCityShippingFee {
  id             Int      @id @default(autoincrement())
  fromCityId     Int
  fromCity       City     @relation("InterCityShippingFrom", fields: [fromCityId], references: [id], onDelete: Cascade)
  toCityId       Int
  toCity         City     @relation("InterCityShippingTo", fields: [toCityId], references: [id], onDelete: Cascade)
  feeExclVatSar  Int
  isActive       Boolean  @default(true)
  sortOrder      Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([fromCityId, toCityId])
  @@index([isActive, sortOrder])
}

/// رسوم لمرة واحدة تُضاف تلقائياً عند إتمام حجز الأسطول (مثل تفويض / إبرام عقد) — غير شامل الضريبة.
model CheckoutOneTimeFee {
  id            Int      @id @default(autoincrement())
  slug          String   @unique @db.VarChar(64)
  labelAr       String   @db.VarChar(255)
  labelEn       String?  @db.VarChar(255)
  feeExclVatSar Int
  isActive      Boolean  @default(true)
  sortOrder     Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([isActive, sortOrder])
}

/// فرع استلام داخل مدينة (مفتاح مستقر `slug` يطابق قيم الحجز والروابط).
model Branch {
  id        Int      @id @default(autoincrement())
  cityId    Int
  city      City     @relation(fields: [cityId], references: [id])
  slug      String   @unique @db.VarChar(64)
  name      String
  nameEn    String?
  tagline   String?  @db.VarChar(255)
  taglineEn String?  @db.VarChar(255)
  address   String?  @db.VarChar(255)
  addressEn String?  @db.VarChar(255)
  detailedAddress String? @db.Text
  detailedAddressEn String? @db.Text
  phone     String?  @db.VarChar(32)
  mapUrl    String?  @db.Text
  latitude  Float?
  longitude Float?
  deliveryFeePerKmSar Float @default(0)
  image     String?  @db.Text
  alt       String?  @db.Text
  sortOrder Int      @default(0)
  isActive  Boolean  @default(true)
  /// يظهر في قسم «فروعنا الجديدة» بالصفحة الرئيسية
  isNew     Boolean  @default(false)
  /// مواعيد العمل بتوقيت السعودية (JSON: { "days": { "0": { "open":"09:00","close":"22:00" }, … } })؛ null = بدون تقييد
  openingHoursJson String? @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  employees AdminEmployee[]
  fleetItems Fleet[]
  pickupBookings  BookingRequest[] @relation("BookingPickupBranch")
  returnBookings  BookingRequest[] @relation("BookingReturnBranch")
  rentalDiscounts RentalDiscount[]

  @@index([cityId])
  @@index([sortOrder])
  @@index([isActive])
  @@index([isNew])
}

/// موظفو لوحة الإدارة: سوبر أدمن ومديرو/موظفو الفروع — ليسوا في جدول `User`.
model AdminEmployee {
  id           Int      @id @default(autoincrement())
  email        String   @unique @db.VarChar(255)
  passwordHash String   @db.VarChar(255)
  name         String?  @db.VarChar(255)
  /// null للسوبر أدمن؛ مطلوب لموظف الفرع
  branchId     Int?
  branch       Branch?  @relation(fields: [branchId], references: [id], onDelete: Restrict)
  isSuperAdmin Boolean  @default(false)
  isActive     Boolean  @default(true)
  
  /// مصفوفة JSON تحتوي على مفاتيح الصلاحيات الممنوحة للموظف (مثل: ["BOOKINGS", "FINANCIALS"])
  permissionsJson String? @db.Text

  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  notifications Notification[]

  @@index([branchId])
  @@index([isActive])
}

model FleetCategory {
  id          Int        @id @default(autoincrement())
  slug        String     @unique @db.VarChar(64)
  title       String
  titleEn     String?
  description String     @db.Text
  descriptionEn String?  @db.Text
  image       String
  alt         String?
  sortOrder   Int        @default(0)
  models      CarModel[]
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
}

/// مجلدات معرض الصور في Spaces: `rentcar/<slug>/`
model GalleryFolder {
  id        Int      @id @default(autoincrement())
  slug      String   @unique @db.VarChar(64)
  label     String   @db.VarChar(255)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([sortOrder])
}

model Brand {
  id        Int        @id @default(autoincrement())
  name      String     @unique
  models    CarModel[]
  rentalDiscounts RentalDiscount[]
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
}

model CarModel {
  id            Int             @id @default(autoincrement())
  name          String
  nameEn        String?
  brandId       Int
  brand         Brand           @relation(fields: [brandId], references: [id])
  categoryId    Int
  category      FleetCategory   @relation(fields: [categoryId], references: [id])

  year          Int
  chairs        Int

  engine        String
  transmission  Transmission
  fuel          FuelType

  /// سعر اليوم بالريال دون ضريبة (يُعرض للزائر كغير شامل للضريبة)
  price         Int
  /// سعر الإيجار الشهري الأساسي دون ضريبة (خصم منفصل عن اليومي×30) — null = لا يوجد عرض شهري لهذا الموديل.
  priceMonthlyExclTax Int?
  /// نسبة ضريبة القيمة المضافة % المسجّلة لهذا الموديل (مثلاً 15 في السعودية) — للفوترة والأرشفة
  vatRatePercent Int @default(15)
  image         String?
  alt           String?
  cta           String?
  ctaEn         String?
  badge         String?
  badgeEn       String?
  /// ترتيب العرض في صفحة الأسطول — الأصغر يظهر أولاً. يُطبَّق على العميل والأدمن معاً.
  displayOrder  Int             @default(0)

  fleetItems         Fleet[]
  bookingRequests    BookingRequest[]
  subscriptionPlans  SubscriptionPlan[]
  rentalDiscounts    RentalDiscount[]

  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  @@index([categoryId])
  @@unique([brandId, name, year])
}

/// كمية متاحة من موديل سيارة في فرع محدّد (التوفر يُحسب لكل فرع على حدة).
model Fleet {
  id         Int       @id @default(autoincrement())
  modelId    Int
  model      CarModel  @relation(fields: [modelId], references: [id], onDelete: Cascade)
  branchId   Int
  branch     Branch    @relation(fields: [branchId], references: [id], onDelete: Cascade)
  quantity   Int       @default(0)
  /// سعر يومي خاص بالفرع (دون ضريبة) — يتجاوز `CarModel.price` عند تحديده. null = السعر الأساسي للموديل.
  pricePerDayExclTax Float?
  /// سعر شهري خاص بالفرع (دون ضريبة) — يتجاوز `CarModel.priceMonthlyExclTax` عند تحديده. null = السعر الأساسي للموديل.
  priceMonthlyExclTax Float?
  /// هل تظهر هذه المركبة للعملاء في صفحة الأسطول (يمكن إخفاؤها حتى لو متاحة)
  isVisible    Boolean  @default(true)
  /// ترتيب العرض في صفحة الأسطول — الأصغر يظهر أولاً (0 = افتراضي)
  displayOrder Int      @default(0)

  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@unique([modelId, branchId])
  @@index([branchId])
  @@index([modelId])
  @@index([isVisible, displayOrder])
}

/// إضافات اختيارية للتأجير (يومية، غير شامل الضريبة) — تُعرض في صفحة إتمام الحجز.
model RentalAddon {
  id             Int      @id @default(autoincrement())
  slug           String   @unique @db.VarChar(64)
  titleAr        String   @db.VarChar(255)
  titleEn        String?  @db.VarChar(255)
  descriptionAr  String?  @db.Text
  descriptionEn  String?  @db.Text
  /// نص معلومات الإضافة الظاهر عبر زر (i): تفاصيل وسياسة الإضافة للعميل.
  infoAr         String?  @db.Text
  infoEn         String?  @db.Text
  /// السعر لكل يوم بالريال (غير شامل الضريبة)
  pricePerDay    Int
  /// مفتاح أيقونة تقريبي للواجهة (مثل key، child، gauge)
  iconKey        String?  @db.VarChar(32)
  /// مجموعة تعارض: لا يُختار أكثر من إضافة واحدة لنفس المعرّف (مثل key-protection)
  exclusiveGroup String?  @db.VarChar(64)
  sortOrder      Int      @default(0)
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([isActive, sortOrder])
}

/// خصومات تأجير يومي — تُدار من الإدارة؛ العميل يرى المبلغ المخصوم فقط دون تفاصيل الشرط.
model RentalDiscount {
  id          Int                  @id @default(autoincrement())
  /// اسم داخلي للإدارة فقط (لا يُعرض للعميل).
  labelAr     String               @db.VarChar(255)
  kind        RentalDiscountKind
  /// PERCENT: 1–100؛ FIXED_DAILY: مبلغ يومي بالريال (دون ضريبة).
  value       Int
  /// بداية الفترة (null = بدون بداية).
  startsAt    DateTime?
  /// نهاية الفترة (null = بدون نهاية).
  endsAt      DateTime?
  brandId     Int?
  brand       Brand?               @relation(fields: [brandId], references: [id], onDelete: Cascade)
  carModelId  Int?
  carModel    CarModel?            @relation(fields: [carModelId], references: [id], onDelete: Cascade)
  branchId    Int?
  branch      Branch?              @relation(fields: [branchId], references: [id], onDelete: Cascade)
  isActive    Boolean              @default(true)
  sortOrder   Int                  @default(0)
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt

  @@index([isActive, sortOrder])
  @@index([brandId])
  @@index([carModelId])
  @@index([branchId])
  @@index([startsAt, endsAt])
}

enum RentalDiscountKind {
  PERCENT
  FIXED_DAILY
}

/// طلب تواصل لحجز شركات (من الصفحة الرئيسية) — يتابعه المشرف يدوياً.
model CorporateBookingLead {
  id           Int      @id @default(autoincrement())
  companyName  String   @db.VarChar(255)
  companyEmail String   @db.VarChar(255)
  taxNumber    String   @db.VarChar(64)
  details      String   @db.Text
  phone        String   @db.VarChar(32)
  status       String   @default("NEW") @db.VarChar(24)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([status, createdAt])
}

model BookingRequest {
  id            Int                 @id @default(autoincrement())
  /// INQUIRY = طلب حجز من الرئيسية (بدون سيارة محددة). DIRECT = حجز مباشر بعد اختيار سيارة.
  kind          BookingRequestKind  @default(INQUIRY)
  /// عند الحجز المباشر فقط — ربط بموديل السيارة المختار.
  carModelId    Int?
  carModel      CarModel?           @relation(fields: [carModelId], references: [id])
  /// عميل مسجّل أنشأ أو يملك الطلب (اختياري).
  customerId    Int?
  customer      User?               @relation(fields: [customerId], references: [id])

  fullName      String
  phone         String
  /// بريد لإرسال الفاتورة بعد إتمام الدفع (يُجمع من صفحة الإتمام).
  contactEmail  String?   @db.VarChar(255)
  /// Legacy fields: نُبقيها للتوافق مع السجلات القديمة؛ البيانات الجديدة تُحفظ في User.
  idDocumentKind           String?   @db.VarChar(24)
  nationalIdNumber         String?   @db.VarChar(16)
  passportNumber           String?   @db.VarChar(32)
  licenseNumber            String?   @db.VarChar(64)
  /// Legacy.
  licenseExpiryDate        DateTime? @db.Date
  idCardImageUrl           String?   @db.Text
  driverLicenseImageUrl    String?   @db.Text
  ageRange      String
  carType       String
  /// Pickup branch FK. See docs/booking-request-branch-fields.md (AR: فرع الاستلام).
  branchId      Int?
  pickupBranch  Branch?  @relation("BookingPickupBranch", fields: [branchId], references: [id], onDelete: SetNull)
  /// Return branch FK. See docs/booking-request-branch-fields.md (AR: فرع الإرجاع).
  returnBranchId Int?
  returnBranch   Branch?  @relation("BookingReturnBranch", fields: [returnBranchId], references: [id], onDelete: SetNull)
  /// Inter-branch return confirmed at return branch. See docs/booking-request-branch-fields.md.
  interBranchReturnConfirmedAt DateTime?
  /// وقت تسجيل استلام العميل للسيارة من الفرع (حالة PICKED_UP).
  vehiclePickedUpAt DateTime?
  /// وقت تسجيل إرجاع السيارة إلى الفرع (حالة RETURNED).
  vehicleReturnedAt DateTime?
  /// استلام من فرع الشركة أو توصيل للعميل (حجز مباشر من الموقع).
  pickupMode    String?   @db.VarChar(16)
  deliveryLat   Float?
  deliveryLng   Float?
  /// عنوان نصّي للتوصيل إن لم يُحدَّد بالخريطة (أو لتفاصيل إضافية).
  deliveryAddress String? @db.Text
  pickupDate    DateTime
  numberOfDays  Int
  termsAccepted Boolean             @default(true)
  /// لقطة JSON للإضافات المختارة عند إنشاء الحجز المباشر (عناوين وأسعار وقت الطلب).
  addonsJson    String?   @db.Text
  /// حالة الدفع: PENDING | PAID | REFUNDED | PARTIAL_REFUND | NO_REFUND
  paymentStatus String    @default("PENDING") @db.VarChar(24)
  /// وقت تأكيد الدفع (تجريبي).
  paidAt        DateTime?
  /// طريقة الدفع المختارة عند الإتمام: TABBY | TAMARA | CARD | POINTS (ربط البوابات لاحقاً).
  paymentMethod String?   @db.VarChar(24)
  /// اسم أو معرّف الموظف/النظام الذي سجل الدفعة
  paymentReceivedBy String? @db.VarChar(128)
  status        String              @default("NEW")
  /// وقت إلغاء الطلب من الحساب (إن وُجد).
  cancelledAt              DateTime?
  /// أيام الإيجار المخصومة عند آخر إلغاء ذاتي (حسب سياسة الشرائح في الإعدادات).
  cancellationDeductedDays Float?
  /// إجمالي المبلغ المسترد للعميل (شامل الضريبة) عند الإلغاء الذاتي بعد دفع ناجح.
  cancellationRefundAmountSar Float?
  /// مرجع من بوابة الاسترداد (أو محاكاة MOCK-… حتى ربط البوابات).
  cancellationRefundExternalRef String? @db.VarChar(128)
  /// سبب الإلغاء — إلزامي عند إلغاء الإدارة مع استرداد كامل يتجاوز سياسة الشرائح.
  cancellationReasonAr String? @db.VarChar(500)
  /// مرجع خارجي لعملية الدفع (رقم عملية الشبكة/التحويل) — يُدخله الموظف عند تسجيل الدفع يدوياً.
  paymentExternalRef String? @db.VarChar(128)
  /// مرجع عملية الدفع الأصلية من بوابة جيديا (orderId) — لازم لتنفيذ الاسترداد الإلكتروني.
  paymentGatewayRef String? @db.VarChar(128)
  /// merchantReferenceId لآخر جلسة دفع جيديا — للمصالحة عند عودة العميل قبل وصول الـ webhook.
  paymentSessionRef String? @db.VarChar(128)
  /// المبلغ الكامل المدفوع بالريال (شامل الضريبة) — يُحفظ لحظة تأكيد الدفع ولا يتغيّر بعدها.
  paidAmountSar Float?
  /// مبلغ مستحق يُحصَّل عند الفرع بعد تعديل/تمديد العميل لحجز مدفوع (فرق السعر). يطالب به الموظف عند تسليم/إرجاع السيارة.
  balanceDueAtBranchSar Float?
  /// مستحقات للعميل (شامل الضريبة): مبلغ يُرَدّ للعميل بعد تعديل قلّص إجمالي حجز مدفوع. يسوّيه الموظف من لوحة الإدارة (قسم مستحقات للعميل).
  refundDueToCustomerSar Float?
  /// وقت تسوية مستحقات العميل من الإدارة. null مع وجود مبلغ = مستحقات قائمة.
  refundDueSettledAt DateTime?
  /// وسيلة تسوية المستحقات: CASH أو نفس وسيلة الدفع الأصلية (CARD/MADA/APPLE_PAY/...).
  refundDueSettledMethod String? @db.VarChar(24)
  /// مرجع عملية التسوية (مرجع بوابة الاسترداد أو مرجع يدوي للنقدي).
  refundDueSettledRef String? @db.VarChar(128)
  /// الموظف الذي نفّذ تسوية المستحقات.
  refundDueSettledBy String? @db.VarChar(128)
  /// إجمالي الحجز المستحق (شامل الضريبة) — snapshot مجمَّد عند إنشاء الحجز أو آخر تعديل للمدة.
  /// يُستخدم بدلاً من إعادة الحساب من السعر الحالي حتى لو تغيّر سعر الموديل لاحقاً.
  snapshotTotalAmountSar Float?
  /// إجمالي ساعات التأخير عن موعد الإرجاع الأساسي عند تسجيل الإرجاع (يُسجَّل فقط عند تجاوز السماحية).
  lateReturnHours Float?
  /// غرامة الإرجاع المتأخر المطبقة (دون ضريبة) بعد خصم بند الساعات المدفوع مسبقاً. 0 = مغطاة أو معفاة.
  lateReturnPenaltyExclTaxSar Float?
  /// أعفى الموظف العميل من غرامة الإرجاع المتأخر.
  lateReturnPenaltyWaived Boolean @default(false)
  /// الموظف الذي قرر تطبيق/إعفاء غرامة الإرجاع المتأخر.
  lateReturnDecidedBy String? @db.VarChar(128)
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt
  logs                BookingLog[]
  paymentTransactions PaymentTransaction[]

  @@index([status, createdAt])
  @@index([branchId])
  @@index([returnBranchId])
  @@index([kind, createdAt])
  @@index([carModelId])
  @@index([customerId])
}

/// عملية مالية مرتبطة بحجز — كل دفعة أو استرداد يُسجَّل هنا بدلاً من الكتابة المباشرة على BookingRequest.
model PaymentTransaction {
  id        Int            @id @default(autoincrement())
  bookingId Int
  booking   BookingRequest @relation(fields: [bookingId], references: [id], onDelete: Restrict)

  /// نوع العملية: INITIAL_PAYMENT | BALANCE_PAYMENT | LATE_PENALTY | REFUND | CUSTOMER_SETTLEMENT
  kind      String  @db.VarChar(32)
  /// PENDING | COMPLETED | FAILED | REVERSED
  status    String  @default("COMPLETED") @db.VarChar(24)
  /// اتجاه المبلغ: CREDIT = داخل للشركة | DEBIT = خارج من الشركة
  direction String  @db.VarChar(8)

  /// المبلغ بالريال — دائماً موجب، الاتجاه يُحدَّد بـ direction
  amountSar Float
  /// CASH | CARD | MADA | APPLE_PAY | TABBY | TAMARA | AMKAN | POINTS
  method    String? @db.VarChar(24)

  /// من نفّذ العملية: CUSTOMER | ADMIN | GATEWAY | SYSTEM
  actorKind  String  @db.VarChar(16)
  actorName  String? @db.VarChar(128)

  /// مرجع بوابة الدفع (orderId جيديا)
  gatewayRef  String? @db.VarChar(128)
  /// مرجع جلسة الدفع (merchantReferenceId جيديا) — للمصالحة
  sessionRef  String? @db.VarChar(128)
  /// مرجع يدوي من الموظف (رقم تحويل / عملية شبكة)
  externalRef String? @db.VarChar(128)

  notes     String?  @db.VarChar(500)
  createdAt DateTime @default(now())

  @@index([bookingId, createdAt])
  @@index([gatewayRef])
  @@index([sessionRef])
  @@index([kind, status, createdAt])
}

/// سجل أحداث الحجز — يُدوَّن تلقائياً عند كل حدث يغيّر حالة الحجز أو بياناته.
model BookingLog {
  id          Int             @id @default(autoincrement())
  booking     BookingRequest  @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  bookingId   Int
  /// كود الحدث: BOOKING_CREATED | STATUS_CHANGED | PAYMENT_RECORDED | VEHICLE_PICKED_UP | ...
  event       String          @db.VarChar(64)
  /// من نفّذ الحدث: CUSTOMER | ADMIN | SYSTEM
  actorKind   String          @db.VarChar(16)
  /// اسم المنفّذ (اسم الموظف أو العميل أو "System")
  actorName   String?         @db.VarChar(128)
  /// حالة الحجز قبل الحدث (للأحداث التي تغيّر الحالة)
  fromStatus  String?         @db.VarChar(32)
  /// حالة الحجز بعد الحدث
  toStatus    String?         @db.VarChar(32)
  /// ملاحظة بشرية بالعربية (سبب الإلغاء، رقم مرجع الدفع...)
  notes       String?         @db.VarChar(500)
  /// JSON لبيانات إضافية مرتبطة بالحدث
  metaJson    String?         @db.Text
  createdAt   DateTime        @default(now())

  @@index([bookingId, createdAt])
}

/// رمز تحقق لمرة واحدة عند إتمام الحجز المباشر — الوجهة `phone:+9665…` أو `email:…`.
model BookingCheckoutOtp {
  id             Int      @id @default(autoincrement())
  destinationKey String   @unique @db.VarChar(320)
  codeHash       String   @db.VarChar(64)
  expiresAt      DateTime
  verifyAttempts Int      @default(0)
  lastSentAt     DateTime @default(now())

  @@index([expiresAt])
}

/// مسودة إتمام حجز مباشر قبل التحقق برمز OTP — تُحذف بعد التأكيد أو عند انتهاء الصلاحية.
model BookingCheckoutDraft {
  token       String   @id @db.VarChar(64)
  payloadJson String   @db.LongText
  expiresAt   DateTime
  createdAt   DateTime @default(now())

  @@index([expiresAt])
}

/// رمز تحقق لتسجيل دخول العميل (منفصل عن رمز إتمام الحجز لتجنب التعارض).
model CustomerLoginOtp {
  id             Int      @id @default(autoincrement())
  destinationKey String @unique @db.VarChar(320)
  codeHash       String   @db.VarChar(64)
  expiresAt      DateTime
  verifyAttempts Int      @default(0)
  lastSentAt     DateTime @default(now())

  @@index([expiresAt])
}

enum BookingRequestKind {
  INQUIRY
  DIRECT
}

enum Transmission {
  MANUAL
  AUTOMATIC
}

enum FuelType {
  GASOLINE
  DIESEL
  HYBRID
  ELECTRIC
}

/** اشتراك شهري بسيارة (باقات). */
enum SubscriptionStatus {
  PENDING
  ACTIVE
  SUSPENDED
  EXPIRED
  CANCELLED
  REJECTED
}

enum SubscriptionPaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
}

enum SubscriptionDocumentKind {
  DRIVERS_LICENSE
  NATIONAL_ID
  OTHER
}

model SubscriptionPlan {
  id                     Int             @id @default(autoincrement())
  slug                   String          @unique @db.VarChar(128)
  carModelId             Int
  carModel               CarModel        @relation(fields: [carModelId], references: [id])
  marketingTitleAr       String?         @db.VarChar(255)
  marketingTitleEn       String?         @db.VarChar(255)
  descriptionAr          String?         @db.Text
  descriptionEn          String?         @db.Text
  /// سعر شهر واحد بالريال (غير شامل الضريبة) — يُجمَّد على الاشتراك عند الطلب.
  monthlyPriceSar        Int
  mileageKmPerMonth      Int
  insuranceIncluded      Boolean         @default(true)
  maintenanceIncluded    Boolean         @default(true)
  depositAmountSar       Int             @default(0)
  /// رسوم كل كيلومتر إضافي بعد استهلاك البدل (بالريال).
  extraKmFeeSarPerKm    Int             @default(3)
  /// أرقام شهرية اختيارية مفصولة بفواصل (عرض/إرشاد)؛ السماح الفعلي للعميل 3–6 أشهر في التطبيق
  durationOptionsCsv      String             @default("3,6,12") @db.VarChar(32)
  isActive               Boolean         @default(true)
  sortOrder              Int             @default(0)
  createdAt              DateTime        @default(now())
  updatedAt              DateTime        @updatedAt

  subscriptions UserSubscription[]

  @@index([carModelId])
  @@index([isActive, sortOrder])
}

model UserSubscription {
  id                       Int                       @id @default(autoincrement())
  planId                   Int
  plan                     SubscriptionPlan          @relation(fields: [planId], references: [id])
  userId                   Int
  user                     User                      @relation(fields: [userId], references: [id])
  status                   SubscriptionStatus        @default(PENDING)
  durationMonths           Int
  /// يوم بدء الباقة الذي اختاره العميل عند الطلب؛ عند التفعيل تُشتق `endAt` تلقائياً بعد عدد الأشهر.
  plannedStartDate          DateTime?
  startAt                  DateTime?
  endAt                    DateTime?
  monthlyPriceSnapshotSar  Int
  mileageAllowanceKm       Int
  mileageUsedKm            Int                       @default(0)
  depositSnapshotSar       Int                       @default(0)
  autoRenew                Boolean                   @default(false)
  rejectionReasonAr        String?                   @db.VarChar(500)
  suspendedReasonAr        String?                   @db.VarChar(500)
  cancelReasonAr           String?                   @db.VarChar(500)
  cancelledAt             DateTime?
  approvedAt              DateTime?
  lastRenewalReminderAt    DateTime?
  nextPaymentDueAt         DateTime?
  unpaidNotifiedAt         DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  payments SubscriptionPayment[]
  documents SubscriptionDocument[]

  @@index([userId, status])
  @@index([planId])
  @@index([status, endAt])
}

model SubscriptionPayment {
  id             Int                         @id @default(autoincrement())
  subscriptionId Int
  subscription    UserSubscription            @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  amountSar      Int
  vatRatePercent Int                         @default(15)
  /// INITIAL | RENEWAL | EXTRA_MILEAGE — نص لتتبّع المنطق دون ENUM إضافي.
  paymentKind      String                       @default("INITIAL") @db.VarChar(32)
  status         SubscriptionPaymentStatus   @default(PENDING)
  paymentMethod  String?                     @db.VarChar(24)
  externalRef    String?                     @db.VarChar(255)
  paidAt         DateTime?
  idempotencyKey String?                     @unique @db.VarChar(128)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([subscriptionId, createdAt])
  @@index([status])
}

model SubscriptionDocument {
  id             Int                       @id @default(autoincrement())
  subscriptionId Int
  subscription   UserSubscription           @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  kind           SubscriptionDocumentKind
  /// مسار ملف تحت دليل رفع مخزِّن على الخادم (لا يعرض مع المسار العام بدون JWT/جلسة).
  storageRelativePath String                   @db.VarChar(512)
  originalFileName String                    @db.VarChar(255)
  mimeType         String                    @db.VarChar(128)
  sizeBytes        Int

  uploadedAt DateTime @default(now())
  verifiedAt DateTime?

  @@index([subscriptionId])
  @@unique([subscriptionId, kind])
}

/// إشعار إداري يرسل للموظفين عند وقوع أحداث هامة (مثل حجز جديد).
model Notification {
  id         Int           @id @default(autoincrement())
  employeeId Int
  employee   AdminEmployee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  title      String        @db.VarChar(255)
  message    String        @db.Text
  isRead     Boolean       @default(false)
  createdAt  DateTime      @default(now())

  @@index([employeeId, isRead, createdAt])
}