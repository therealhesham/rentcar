generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

/// إعدادات عامة للموقع (مفتاح فريد + قيمة نصية).
model SiteSetting {
  id        Int      @id @default(autoincrement())
  key       String   @unique @db.VarChar(64)
  value     String   @db.Text
  updatedAt DateTime @updatedAt
}

/// حساب عميل على الموقع (تسجيل / دخول).
model User {
  id           Int      @id @default(autoincrement())
  email        String   @unique @db.VarChar(255)
  passwordHash String?  @db.VarChar(255)
  name         String?  @db.VarChar(255)
  /// موحّد مع الحجز: +9665XXXXXXXX
  phone        String?  @unique @db.VarChar(16)
  /// حساب بصلاحيات إدارية (لوحة التحكم المستقبلية أو تقارير داخلية).
  isAdmin      Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  bookingRequests BookingRequest[]
}

/// مدينة تتبعها فروع الاستلام (للتجميع في الحجز ولوحة الإدارة).
model City {
  id        Int      @id @default(autoincrement())
  slug      String   @unique @db.VarChar(64)
  name      String   @db.VarChar(255)
  sortOrder Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  branches Branch[]

  @@index([sortOrder])
  @@index([isActive])
}

/// فرع استلام داخل مدينة (مفتاح مستقر `slug` يطابق قيم الحجز والروابط).
model Branch {
  id        Int      @id @default(autoincrement())
  cityId    Int
  city      City     @relation(fields: [cityId], references: [id])
  slug      String   @unique @db.VarChar(64)
  name      String
  tagline   String?  @db.VarChar(255)
  address   String?  @db.VarChar(255)
  phone     String?  @db.VarChar(32)
  mapUrl    String?  @db.Text
  image     String?  @db.Text
  alt       String?  @db.Text
  sortOrder Int      @default(0)
  isActive  Boolean  @default(true)
  /// يظهر في قسم «فروعنا الجديدة» بالصفحة الرئيسية
  isNew     Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([cityId])
  @@index([sortOrder])
  @@index([isActive])
  @@index([isNew])
}

model FleetCategory {
  id          Int        @id @default(autoincrement())
  slug        String     @unique @db.VarChar(64)
  title       String
  description String     @db.Text
  image       String
  alt         String?
  sortOrder   Int        @default(0)
  models      CarModel[]
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
}

/// مجلدات معرض الصور في Spaces: `rentcar/<slug>/`
model GalleryFolder {
  id        Int      @id @default(autoincrement())
  slug      String   @unique @db.VarChar(64)
  label     String   @db.VarChar(255)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([sortOrder])
}

model Brand {
  id        Int        @id @default(autoincrement())
  name      String     @unique
  models    CarModel[]
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
}

model CarModel {
  id            Int             @id @default(autoincrement())
  name          String
  brandId       Int
  brand         Brand           @relation(fields: [brandId], references: [id])
  categoryId    Int
  category      FleetCategory   @relation(fields: [categoryId], references: [id])

  year          Int
  chairs        Int

  engine        String
  transmission  Transmission
  fuel          FuelType

  /// سعر اليوم بالريال دون ضريبة (يُعرض للزائر كغير شامل للضريبة)
  price         Int
  /// نسبة ضريبة القيمة المضافة % المسجّلة لهذا الموديل (مثلاً 15 في السعودية) — للفوترة والأرشفة
  vatRatePercent Int @default(15)
  image         String?
  alt           String?
  cta           String?
  badge         String?

  fleetItems      Fleet[]
  bookingRequests BookingRequest[]

  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  @@index([categoryId])
  @@unique([brandId, name, year])
}

model Fleet {
  id         Int       @id @default(autoincrement())
  modelId     Int
  model       CarModel  @relation(fields: [modelId], references: [id])
  quantity    Int       @default(0)

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

/// إضافات اختيارية للتأجير (يومية، غير شامل الضريبة) — تُعرض في صفحة إتمام الحجز.
model RentalAddon {
  id             Int      @id @default(autoincrement())
  slug           String   @unique @db.VarChar(64)
  titleAr        String   @db.VarChar(255)
  descriptionAr  String?  @db.Text
  /// السعر لكل يوم بالريال (غير شامل الضريبة)
  pricePerDay    Int
  /// مفتاح أيقونة تقريبي للواجهة (مثل key، child، gauge)
  iconKey        String?  @db.VarChar(32)
  sortOrder      Int      @default(0)
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([isActive, sortOrder])
}

model BookingRequest {
  id            Int                 @id @default(autoincrement())
  /// INQUIRY = طلب حجز من الرئيسية (بدون سيارة محددة). DIRECT = حجز مباشر بعد اختيار سيارة.
  kind          BookingRequestKind  @default(INQUIRY)
  /// عند الحجز المباشر فقط — ربط بموديل السيارة المختار.
  carModelId    Int?
  carModel      CarModel?           @relation(fields: [carModelId], references: [id])
  /// عميل مسجّل أنشأ أو يملك الطلب (اختياري).
  customerId    Int?
  customer      User?               @relation(fields: [customerId], references: [id])

  fullName      String
  phone         String
  ageRange      String
  carType       String
  branch        String
  /// استلام من فرع الشركة أو توصيل للعميل (حجز مباشر من الموقع).
  pickupMode    String?   @db.VarChar(16)
  deliveryLat   Float?
  deliveryLng   Float?
  /// عنوان نصّي للتوصيل إن لم يُحدَّد بالخريطة (أو لتفاصيل إضافية).
  deliveryAddress String? @db.Text
  pickupDate    DateTime
  numberOfDays  Int
  termsAccepted Boolean             @default(true)
  /// لقطة JSON للإضافات المختارة عند إنشاء الحجز المباشر (عناوين وأسعار وقت الطلب).
  addonsJson    String?   @db.Text
  /// حالة الدفع للحجز: PENDING (بانتظار الدفع) أو PAID (تم الدفع — وضع تجريبي).
  paymentStatus String    @default("PENDING") @db.VarChar(16)
  /// وقت تأكيد الدفع (تجريبي).
  paidAt        DateTime?
  /// طريقة الدفع المختارة عند الإتمام: TABBY | TAMARA | CARD | POINTS (ربط البوابات لاحقاً).
  paymentMethod String?   @db.VarChar(24)
  status        String              @default("NEW")
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt

  @@index([status, createdAt])
  @@index([branch])
  @@index([kind, createdAt])
  @@index([carModelId])
  @@index([customerId])
}

enum BookingRequestKind {
  INQUIRY
  DIRECT
}

enum Transmission {
  MANUAL
  AUTOMATIC
}

enum FuelType {
  GASOLINE
  DIESEL
  HYBRID
  ELECTRIC
}